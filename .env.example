# Кабинет клиента MARKET — переменные окружения.
# Скопируйте в .env и заполните. Сам .env в git не лежит.
#
#   cp .env.example .env && chmod 600 .env

# ── Приложение ───────────────────────────────────────────────────────────
# MARKET_DEBUG=1 только для локальной отладки, в проде выключено.
MARKET_DEBUG=0
MARKET_HOST=127.0.0.1
MARKET_PORT=5000

# Секрет сессии. Если не задать, ключ создастся в data/SECRET_KEY при первом
# запуске и переживёт перезапуск, но задать вручную правильнее: при переносе
# на другой сервер все сессии сбрасываются один раз осознанно.
# Сгенерировать: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# MARKET_SECRET_KEY=

# Ключ шифрования API-ключей Wildberries (Fernet). ВАЖНО: при смене ключа
# сохранённые API-ключи клиентов перестанут расшифровываться.
# Сгенерировать: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# MARKET_FERNET_KEY=

# ── Администратор (создаётся командой ./run.sh init) ─────────────────────
MARKET_ADMIN_EMAIL=admin@example.ru
MARKET_ADMIN_PASSWORD=ChangeMe_2026

# ── Торговые марки в интерфейсе ──────────────────────────────────────────
MARKET_BRAND_NAME=MARKET
MARKET_BRAND_SUB=Кабинет клиента

# ── Ограничения ──────────────────────────────────────────────────────────
# Один файл, МБ. Ставится в nginx отдельным директивным уровнем.
MARKET_MAX_UPLOAD_MB=20